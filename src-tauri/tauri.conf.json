{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Database Backup Manager",
  "version": "0.1.0",
  "identifier": "com.kasaindia.dbbackup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Database Backup Manager",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Back up Supabase/PostgreSQL databases securely.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
