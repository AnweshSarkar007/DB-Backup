# Database Backup Manager — example environment variables.
# Copy to `.env` for local development. NEVER commit a real `.env` (see .gitignore).

# Password for the example job spec's `secret_reference: "env:DBM_PG_PASSWORD"`.
# In production the password lives in Windows Credential Manager, not here.
DBM_PG_PASSWORD=

# A full Supabase/PostgreSQL URI used only by the env-gated live smoke test:
#   cargo test -p dbm-core --test live_smoke -- --ignored --nocapture
# The password is extracted in-memory and never persisted.
DBM_LIVE_PG_URL=

# Optional overrides (Rule 4: no hard-coded paths):
#   DBM_DATA_DIR    override the app data directory (default: %ProgramData%\DatabaseBackupManager)
#   DBM_DOCKER_PATH path to the docker executable (default: "docker" on PATH)
#   DBM_LOG         tracing filter (default: "info"), e.g. "dbm_core=debug"
